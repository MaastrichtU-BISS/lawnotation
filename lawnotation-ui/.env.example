# Local development (pnpm dev). In a container use the NUXT_* names instead
# (NUXT_PUBLIC_BASE_URL, NUXT_AUTH_CLIENT_SECRET, ...; see docker-compose.coolify.yml).

# Postgres built from db/migrations: pnpm db:migrate (pnpm db:seed adds test data)
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/lawnotation"

# Where this app is reachable; sign-in redirects and email links use it
BASE_URL="http://localhost:3000"

# Sign-in: Keycloak realm lawnotation. The client allows
# http://localhost:3000/api/auth/callback for development.
AUTH_ISSUER="https://auth.lawnotation.org/realms/lawnotation"
AUTH_CLIENT_ID="lawnotation"
AUTH_CLIENT_SECRET="<from the Keycloak client's Credentials tab>"
# Any long random string: openssl rand -hex 32
AUTH_SESSION_SECRET="<random>"

# Optional: assignment and invitation emails. Without it no email is sent.
SMTP_URL=""

IAA_SERVICE_URL="http://127.0.0.1:8080"
IAA_API_KEY="<Check IAA API Key in Coolify>"
CITATIONS_API_KEY="<Check Citations API Key>"
MLBACKEND_URL=""
